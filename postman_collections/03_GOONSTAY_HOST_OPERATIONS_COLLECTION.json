        {
          "name": "1. Become a Host (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('host_token', data.access);",
                  "    pm.collectionVariables.set('host_refresh', data.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"host_vikram\",\n  \"email\": \"vikram@hotelgrand.com\",\n  \"password\": \"HostPassword123!\",\n  \"first_name\": \"Vikram\",\n  \"last_name\": \"Singhania\",\n  \"phone_number\": \"9876543299\",\n  \"bank_name\": \"State Bank of India\",\n  \"account_holder_name\": \"Vikram Singhania\",\n  \"account_number\": \"123456789012\",\n  \"ifsc_code\": \"SBIN0001234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/become-host/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "become-host",
                ""
              ]
            }
          }
        },
        {
          "name": "2. Host Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Access token returned', function () { pm.expect(pm.response.json().access).to.be.a('string'); });",
                  "pm.test('User is Hotel Owner', function () {",
                  "    var data = pm.response.json();",
                  "    var role = data.role || (data.user && data.user.role);",
                  "    pm.expect(['HOTEL_OWNER', 'ADMIN']).to.include(role);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    var token = data.access || data.token;",
                  "    var refresh = data.refresh || (data.tokens && data.tokens.refresh);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('host_token', token);",
                  "        pm.collectionVariables.set('hostToken', token);",
                  "        try { pm.environment.set('host_token', token); } catch(e){}",
                  "        try { pm.environment.set('hostToken', token); } catch(e){}",
                  "    }",
                  "    if (refresh) {",
                  "        pm.collectionVariables.set('host_refresh', refresh);",
                  "        try { pm.environment.set('host_refresh', refresh); } catch(e){}",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vikram@hotelgrand.com\",\n  \"password\": \"HostPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/host/login/",
              "host": [
