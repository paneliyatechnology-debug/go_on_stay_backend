SECRET_KEY=your-django-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Set USE_POSTGRES=False to use SQLite db.sqlite3)
USE_POSTGRES=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bookmyroom_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Razorpay Payment Gateway Configuration
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_bookmyroom_key_2026
RAZORPAY_KEY_SECRET=rzp_test_bookmyroom_secret_2026
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_bookmyroom_2026

# Gmail SMTP Configuration (For OTP & Booking Emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
