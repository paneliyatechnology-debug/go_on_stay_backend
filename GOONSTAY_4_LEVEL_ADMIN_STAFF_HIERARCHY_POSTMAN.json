{
  "info": {
    "_postman_id": "goonstay-4-level-hierarchy-polished-v2",
    "name": "GoOnStay - \ud83d\udc51 4-Level Admin & Staff Hierarchy System",
    "description": "Dedicated, beautifully-structured Postman Collection for GoOnStay 4-Level Admin & Staff Hierarchy (Admin > Main Manager > Dept Manager > Staff) and Mandatory TOTP Multi-Factor Authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. \ud83d\udee1\ufe0f Multi-Factor Authentication (MFA Engine)",
      "description": "Mandatory TOTP MFA for Level 2 (Dept Manager), Level 3 (Main Manager), and Level 4 (Admin). Zero external dependencies, RFC 6238 compliant.",
      "item": [
        {
          "name": "POST 1. Setup MFA (Get Secret, QR URI & 8 Backup Codes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.temp_token) {",
                  "    pm.environment.set('temp_token', jsonData.temp_token);",
                  "    pm.environment.set('totp_secret', jsonData.secret);",
                  "    console.log('Saved temp_token and totp_secret to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"temp_token\": \"{{temp_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/staff/mfa/setup/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "staff",
                "mfa",
                "setup",
                ""
              ]
            },
            "description": "Initiate TOTP MFA enrollment. Returns a 160-bit Base32 secret, otpauth:// provisioning URI for authenticator apps, and 8 one-time alphanumeric backup recovery codes."
          }
        },
        {
          "name": "POST 2. Verify Initial MFA Enrollment (Activate MFA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.access) {",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    pm.environment.set('token', jsonData.access);",
                  "    console.log('MFA Enrolled successfully! Saved access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"temp_token\": \"{{temp_token}}\",\n    \"totp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/staff/mfa/enroll-verify/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "staff",
                "mfa",
                "enroll-verify",
                ""
              ]
            },
            "description": "Verifies the first 6-digit TOTP code generated by Google Authenticator / Microsoft Authenticator. Activates MFA on the account and returns full JWT tokens."
          }
        },
        {
          "name": "POST 3. Manager Login Challenge (Verify 6-Digit TOTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.access) {",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    pm.environment.set('token', jsonData.access);",
                  "    console.log('Login MFA Challenge passed! Token updated.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"temp_token\": \"{{temp_token}}\",\n    \"totp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/staff/mfa/verify/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "staff",
                "mfa",
                "verify",
                ""
              ]
            },
            "description": "Step 2 of manager login when credentials return 'mfa_required': true. Verifies 6-digit TOTP code and grants JWT session tokens."
          }
        },
        {
          "name": "POST 4. Emergency Recovery (Verify 8-Char Backup Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.access) {",
                  "    pm.environment.set('access_token', jsonData.access);",
                  "    console.log('Backup code verified! Token granted.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"temp_token\": \"{{temp_token}}\",\n    \"backup_code\": \"ABCD-EFGH\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/staff/mfa/verify/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "staff",
                "mfa",
                "verify",
                ""
              ]
            },
            "description": "Emergency access when authenticator device is lost. Uses one of the 8 hashed backup codes. The used code is permanently consumed."
          }
        },
        {
          "name": "POST 5. Admin MFA Reset / Disable Account MFA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user_id\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/staff/mfa/disable/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "staff",
                "mfa",
                "disable",
                ""
              ]
            },
            "description": "Platform Administrator emergency reset for a locked or lost authenticator device."
          }
        }
      ]
    },
